# AgriCore backend environment — copy to `.env` and fill in real values.
# NEVER commit the real .env (it is gitignored).

# ==================== Core / security ====================
SECRET_KEY=change-me-to-a-long-random-string
# Leave DEBUG off in production; set True only for local development.
DEBUG=False
# Comma-separated hosts allowed to serve the API in production.
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# ==================== Database ====================
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ==================== CORS / cookies ====================
# Prefer an explicit allow-list in production instead of allow-all.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-web-app.example
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# ==================== Cache / realtime ====================
REDIS_URL=redis://localhost:6379/0

# ==================== Payments (IntaSend) ====================
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_...
INTASEND_SECRET_KEY=ISSecretKey_test_...
INTASEND_TEST=True
INTASEND_WEBHOOK_CHALLENGE=set-a-shared-secret
PLATFORM_FEE_PERCENT=0
DEFAULT_CURRENCY=UGX

# (Legacy Flutterwave keys — kept for the webhook compatibility layer)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# ==================== SMS (Africa's Talking) ====================
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=

# ==================== AI providers ====================
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ==================== Media (Cloudinary) ====================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================== Supabase (storage/auth, if used) ====================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==================== Auth (Google OAuth) ====================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_IDS=

# ==================== Error monitoring (Sentry) ====================
# Leave empty to disable. When set, backend errors are reported.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
